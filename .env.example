# Mandatory — required for a working production deploy

# Django core settings
DJANGO_SECRET_KEY=a-very-super-strong-secret-key-that-is-very-hard-to-guess
DJANGO_DEBUG=true
DJANGO_ENV=development
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1,http://localhost

# Supabase Postgres connection string for Django ORM
DATABASE_URL=
# Alternate Postgres fields used only when DATABASE_URL is unset
# DB_HOST=
# DB_NAME=postgres
# DB_USER=postgres
# DB_PASSWORD=
# DB_PORT=5432
# DB_SSLMODE=require
# DB_CONN_MAX_AGE=60

# Cloudflare Turnstile keys for contact form bot protection
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# SMTP settings for OTP and contact delivery (ssl | tls | plain)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USE_SECURITY=ssl
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
EMAIL_TO=

# Contact form OTP and rate-limit controls
CONTACT_MIN_SUBMIT_INTERVAL_SECONDS=45
CONTACT_OTP_TTL_SECONDS=600
CONTACT_OTP_LENGTH=6
CONTACT_OTP_MAX_ATTEMPTS=5

# Optional — features and overrides you can leave default

# Supabase API client credentials (separate from DATABASE_URL)
SUPABASE_URL=
SUPABASE_KEY=

# Chatbot provider (local | openai | gemini | auto) and shared model name
CHATBOT_PROVIDER=local
CHATBOT_MODEL=
CHATBOT_TIMEOUT_SECONDS=20
CHATBOT_MAX_CONTEXT_CHARS=6500
CHATBOT_MIN_SUBMIT_INTERVAL_SECONDS=2
OPENAI_API_KEY=
GEMINI_API_KEY=

# Resume secret unlock flow used by the chatbot
RESUME_URL=
RESUME_ACCESS_KEY=
RESUME_SECRET_KEY=RESUME-LINK

# Public site display name shown in emails and UI
SITE_DISPLAY_NAME=Raju Jha

# Optional security / diagnostics overrides (production-safe defaults apply automatically)
# SECURE_SSL_REDIRECT=true
# SESSION_COOKIE_SECURE=true
# CSRF_COOKIE_SECURE=true
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=true
# SECURE_HSTS_PRELOAD=true
# ENABLE_ERROR_TEST_ROUTES=false
