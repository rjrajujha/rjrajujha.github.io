EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_TO=owner@example.com
CONTACT_MIN_SUBMIT_INTERVAL_SECONDS=45

CHATBOT_PROVIDER=local
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
CHATBOT_TIMEOUT_SECONDS=20
CHATBOT_STORE_LOGS=False
CHATBOT_MAX_CONTEXT_CHARS=6500
CHATBOT_MIN_SUBMIT_INTERVAL_SECONDS=2

RESUME_URL=http://rajujha.dev/resume/?id=latest
RESUME_ACCESS_KEY=your-resume-access-key
RESUME_SECRET_KEY=RESUME-LINK
