DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_PRODUCTION=False
# Set to true only for local production error-page verification (/debug/raise-500/)
ENABLE_ERROR_TEST_ROUTES=False
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,rjrajujha-github-io.vercel.app,portfolio.rajujha.dev
DJANGO_CSRF_TRUSTED_ORIGINS=https://rjrajujha-github-io.vercel.app,https://portfolio.rajujha.dev

# Database (optional — default off)
USE_DATABASE=false
