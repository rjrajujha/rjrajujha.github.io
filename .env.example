# Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_PRODUCTION=false
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=
ENABLE_ERROR_TEST_ROUTES=false

# Database (optional — default off)
USE_DATABASE=false
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=portfolio
# DB_USER=portfolio_app
# DB_PASSWORD=change-me
# DB_HOST=localhost
# DB_PORT=5432
# SQLITE_PATH=/tmp/db.sqlite3

# Email
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_FROM=
EMAIL_SECURE_PROTOCOL=tls
EMAIL_TO=
CONTACT_MIN_SUBMIT_INTERVAL_SECONDS=45

# AI
CHATBOT_PROVIDER=local
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
CHATBOT_TIMEOUT_SECONDS=20
CHATBOT_STORE_LOGS=false
CHATBOT_MAX_CONTEXT_CHARS=6500
CHATBOT_MIN_SUBMIT_INTERVAL_SECONDS=2

# Resume
RESUME_URL=
RESUME_ACCESS_KEY=
RESUME_SECRET_KEY=RESUME-LINK

# Production security (when DJANGO_PRODUCTION=true)
SECURE_SSL_REDIRECT=true
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=true
SECURE_HSTS_PRELOAD=true
